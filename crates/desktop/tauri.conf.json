{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Djigui Desktop",
  "version": "0.1.0",
  "identifier": "com.sodevitel.djigui",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Djigui — Gestion commerciale",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 650,
        "maximized": true,
        "url": "http://localhost:1704/login.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
